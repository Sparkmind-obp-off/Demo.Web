# ==========================================================
#  Cloudflare Pages — HTTP headers
#  Berlaku otomatis setelah deploy (file ini disalin ke dist/).
# ==========================================================

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Aset statis diberi nama tetap, jadi cache 1 tahun aman.
# Ganti nama file bila isinya berubah, atau turunkan max-age bila perlu.
/static/img/*
  Cache-Control: public, max-age=31536000, immutable

/static/favicon.svg
  Cache-Control: public, max-age=604800

# CSS & JS di-cache singkat + revalidate agar update cepat terlihat.
/static/style.css
  Cache-Control: public, max-age=3600, must-revalidate

/static/app.js
  Cache-Control: public, max-age=3600, must-revalidate
